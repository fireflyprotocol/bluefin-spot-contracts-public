# specify the chain you want to deploy/build contracts against mainnet | testnet | devnet
DEPLOY_ON = testnet

# private key of the deployer
DEPLOYER_KEY = 

# phrase of the deployer - if DEPLOYER_KEY is provided it will be used over DEPLOYER_PHRASE
# DEPLOYER_PHRASE = 

# type of wallet. only supported Secp256k1 and ED25519. defaults to Secp256k1
WALLET_SCHEME = ED25519